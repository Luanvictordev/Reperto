{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Repertório",
  "version": "0.1.0",
  "identifier": "com.setlistmaker.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Repertório",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:setlistmaker.db"]
    }
  }
}
